---
// The colophon: two rows under the page's closing press rule.
//   Row 1: signature mark (home) · site links · email + Copy
//   Row 2 (after a hairline): copyright · profiles
// On phones row 1 wraps into signature + email, then the links; row 2 stays one line.
import EmailContact from '@/components/EmailContact.astro';
import Signature from '@/components/Signature.astro';
import { author, social } from '@/data/site';

const year = new Date().getFullYear();

const nav = [
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Writing' },
];

const profiles = [
  { href: social.github, label: 'GitHub' },
  { href: social.linkedin, label: 'LinkedIn' },
];
---

<footer class="site-footer">
  <div class="max-w-5xl mx-auto px-6">

    <div class="footer-main">
      <a href="/" class="footer-mark" aria-label={`${author.name}, home`}>
        <Signature animated={false} />
      </a>
      <nav class="footer-nav" aria-label="Footer">
        {nav.map(({ href, label }) => (
          <a href={href} class="footer-link">{label}</a>
        ))}
      </nav>
      <div class="footer-email">
        <EmailContact />
      </div>
    </div>

    <div class="footer-base">
      <span class="footer-copy">&copy; {year} {author.name}</span>
      <div class="footer-profiles">
        {profiles.map(({ href, label }) => (
          <a href={href} class="footer-link" target="_blank" rel="noopener noreferrer">{label} <span aria-hidden="true">↗</span></a>
        ))}
      </div>
    </div>

  </div>
</footer>

<style>
  .site-footer {
    border-top: 2px solid var(--color-rule);
  }

  /* Row 1: mark, links, email on one line (desktop). */
  .footer-main {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.5rem 2.5rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  .footer-mark {
    display: inline-flex;
    color: var(--color-text);
    padding-block: 0.25rem;
    transition: opacity 0.15s ease;
  }
  .footer-mark:hover { opacity: 0.6; }

  .footer-nav,
  .footer-profiles {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.75rem;
  }
  .footer-nav { justify-content: center; }

  .footer-link {
    display: inline-block;
    padding-block: 0.375rem;       /* ~30px target: above the 24px WCAG 2.5.8 floor, spaced apart */
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);        /* ink: links, unlike the faint copyright line */
    text-decoration: none;
    transition: color 0.12s ease;
  }
  .footer-link:hover { color: var(--color-accent); }

  /* Row 2: copyright and profiles on one line, everywhere. */
  .footer-base {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    flex-wrap: wrap;
    padding: 0.5rem 0;
  }

  .footer-copy {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.05em;
    color: var(--color-text-faint);
  }

  @media (max-width: 640px) {
    /* Row 1 becomes: signature + email, then the links. */
    .footer-main {
      grid-template-columns: auto 1fr;
      grid-template-areas:
        "mark email"
        "nav  nav";
      gap: 0.25rem 1rem;
      padding: 1rem 0 0.75rem;
    }
    .footer-mark { grid-area: mark; }
    .footer-email { grid-area: email; justify-self: end; }
    .footer-nav { grid-area: nav; justify-content: flex-start; gap: 0 1.5rem; }
  }

  @media (max-width: 400px) {
    /* Too narrow for mark and email side by side: stack them, still compact. */
    .footer-main { grid-template-columns: 1fr; grid-template-areas: "mark" "email" "nav"; }
    .footer-email { justify-self: start; }
  }
</style>
