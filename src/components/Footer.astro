---
// The colophon: two rows under the page's closing press rule.
//   Row 1: © year + signature mark (home) · site links · email + Copy
//   Row 2 (after a hairline): Privacy (+ Cookies) · profiles
// The name appears once, as the signature; the copyright line borrows it
// (screen readers still hear "© 2026 Alex Botzis").
// On phones row 1 stacks: year + signature, email, links; row 2 stays one line.
import EmailContact from '@/components/EmailContact.astro';
import Signature from '@/components/Signature.astro';
import { author, gaId, social } from '@/data/site';

const year = new Date().getFullYear();

const nav = [
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Writing' },
];

const profiles = [
  { href: social.github, label: 'GitHub' },
  { href: social.linkedin, label: 'LinkedIn' },
];
---

<footer class="site-footer">
  <div class="max-w-5xl mx-auto px-6">

    <div class="footer-main">
      <div class="footer-sign">
        <span class="footer-copy">&copy; {year}<span class="sr-only"> {author.name}</span></span>
        <a href="/" class="footer-mark" aria-label={`${author.name}, home`}>
          <Signature animated={false} />
        </a>
      </div>
      <nav class="footer-nav" aria-label="Footer">
        {nav.map(({ href, label }) => (
          <a href={href} class="footer-link">{label}</a>
        ))}
      </nav>
      <div class="footer-email">
        <EmailContact />
      </div>
    </div>

    <div class="footer-base">
      <div class="footer-legal">
        <a href="/privacy" class="footer-minor">Privacy</a>
        {gaId && <button type="button" class="footer-minor" data-consent-open="footer">Cookies</button>}
      </div>
      <div class="footer-profiles">
        {profiles.map(({ href, label }) => (
          <a href={href} class="footer-link" target="_blank" rel="noopener noreferrer">{label} <span aria-hidden="true">↗</span></a>
        ))}
      </div>
    </div>

  </div>
</footer>

<style>
  .site-footer {
    border-top: 2px solid var(--color-rule);
  }

  /* Row 1: mark, links, email on one line (desktop). */
  .footer-main {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.5rem 2.5rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  .footer-sign {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-mark {
    display: inline-flex;
    color: var(--color-text);
    padding-block: 0.25rem;
    transition: opacity 0.15s ease;
  }
  .footer-mark:hover { opacity: 0.6; }

  .footer-nav,
  .footer-profiles {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.75rem;
  }
  .footer-nav { justify-content: center; }

  .footer-link {
    display: inline-block;
    padding-block: 0.375rem;       /* ~30px target: above the 24px WCAG 2.5.8 floor, spaced apart */
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);        /* ink: links, unlike the faint copyright line */
    text-decoration: none;
    transition: color 0.12s ease;
  }
  .footer-link:hover { color: var(--color-accent); }

  /* Row 2: Privacy (+ Cookies) and profiles on one line, everywhere. */
  .footer-base {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    flex-wrap: wrap;
    padding: 0.5rem 0;
  }

  .footer-copy,
  .footer-legal {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.05em;
    color: var(--color-text-faint);
  }
  .footer-copy { white-space: nowrap; }
  .footer-legal { display: flex; gap: 1.25rem; }

  /* Privacy link and Cookies button: quiet, faint mono.
     Hover is the shared red wipe (global.css), from faint ink. */
  .footer-minor {
    background-color: transparent;
    border: none;
    padding: 0.375rem 0;
    cursor: pointer;
    font: inherit;
    letter-spacing: inherit;
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  @media (max-width: 640px) {
    /* Row 1 stacks: © year + signature, then email, then the links. (With the
       year beside it, the signature no longer leaves room for the email.) */
    .footer-main {
      grid-template-columns: 1fr;
      grid-template-areas: "mark" "email" "nav";
      gap: 0.25rem 1rem;
      padding: 1rem 0 0.75rem;
    }
    .footer-sign { grid-area: mark; }
    .footer-email { grid-area: email; }
    .footer-nav { grid-area: nav; justify-content: flex-start; gap: 0 1.5rem; }
  }
</style>
