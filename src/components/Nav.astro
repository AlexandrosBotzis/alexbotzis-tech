---
import Signature from '@/components/Signature.astro';
import EmailContact from '@/components/EmailContact.astro';
import { social } from '@/data/site';

const links = [
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Writing' },
];
const pathname = Astro.url.pathname;
function isActive(href: string) { return pathname.startsWith(href); }
---

<header id="site-header" style="border-bottom: 2px solid var(--color-rule); background: var(--color-bg); position: sticky; top: 0; z-index: 100;">
  <nav class="max-w-5xl mx-auto px-6 h-14 flex items-center justify-between" aria-label="Main">
    <a href="/" class="nav-logo-link" aria-label="Alex Botzis">
      <!-- The AB mark: A and B parted along the stroke they once shared. The A's
           crossbar runs into a red square that caps it, echoing the red-capped
           crossbar of the pixel logo. Same geometry as /ab-favicon-16.svg. -->
      <svg class="nav-logo" viewBox="0 0 16 16" aria-hidden="true">
        <rect width="16" height="16" fill="#111111" />
        <g transform="translate(8 8) scale(0.86) translate(-8 -8)">
          <!-- Flat ends, sharp corners: legs run past the baseline and the
               letters are clipped to one cap height and baseline, giving
               horizontal feet and a flat apex like Geist's A. -->
          <clipPath id="logo-cap"><rect x="-1" y="2.2" width="18" height="11.6" /></clipPath>
          <g clip-path="url(#logo-cap)" fill="none" stroke="#FFFFFF" stroke-width="1.6" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="8">
            <path d="M0.5 14.5 5.1 3 9.7 14.5M2.5 9.4H7.7" />
            <path d="M11.4 8a2.5 2.5 0 0 0 0-5H7.9L11.9 13H12.4a2.5 2.5 0 0 0 0-5H9.9" />
          </g>
          <!-- Red square: caps the crossbar, echoing the pixel logo's red square. -->
          <rect class="logo-node" x="8.16" y="8.5" width="1.8" height="1.8" />
        </g>
      </svg>
    </a>

    <!-- Desktop nav -->
    <ul class="nav-links" style="list-style: none; margin: 0; padding: 0;">
      {links.map(({ href, label }) => (
        <li>
          <a href={href} class={`nav-link${isActive(href) ? ' active' : ''}`} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>
        </li>
      ))}
      <li class="nav-sep">
        <button id="theme-toggle" class="nav-link theme-toggle" aria-label="Toggle dark mode">Dark</button>
      </li>
    </ul>

    <!-- Mobile burger -->
    <button id="burger" class="burger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
      <span class="bar bar-1"></span>
      <span class="bar bar-2"></span>
      <span class="bar bar-3"></span>
    </button>
  </nav>
</header>

<!-- Mobile fullscreen menu: the three destinations, then the same sign-off
     band as the footer (signature, email, profiles), then the theme switch. -->
<!-- No aria-modal: the close control (#burger) lives in the header, outside this
     element. main and the footer go inert instead, so focus stays on header + menu. -->
<div id="mobile-menu" class="mobile-menu" role="dialog" aria-label="Menu" aria-hidden="true" inert>
  <nav class="mobile-nav" aria-label="Main menu">
    {links.map(({ href, label }) => (
      <a href={href} class={`mobile-link${isActive(href) ? ' active' : ''}`} aria-current={isActive(href) ? 'page' : undefined}>
        <span class="mobile-label">{label}</span>
      </a>
    ))}
  </nav>

  <!-- Colophon: the same two rows as the page footer, in thumb reach. -->
  <div class="mobile-colophon">
    <div class="mobile-colophon-main">
      <a href="/" class="mobile-mark" aria-label="Alex Botzis, home">
        <Signature animated={false} />
      </a>
      <EmailContact />
    </div>
    <div class="mobile-colophon-base">
      <div class="mobile-profiles">
        <a href={social.github} target="_blank" rel="noopener noreferrer" class="mono-link">GitHub <span aria-hidden="true">↗</span></a>
        <a href={social.linkedin} target="_blank" rel="noopener noreferrer" class="mono-link">LinkedIn <span aria-hidden="true">↗</span></a>
      </div>
      <button id="mobile-theme-btn" class="mobile-theme-row">
        <span class="mobile-theme-label">Switch to</span>
        <span id="mobile-theme-state" class="mobile-theme-state">Dark</span>
      </button>
    </div>
  </div>
</div>

<script>
  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle') as HTMLButtonElement;
  const mobileBtn = document.getElementById('mobile-theme-btn') as HTMLButtonElement;
  const mobileState = document.getElementById('mobile-theme-state') as HTMLElement;

  function isDark() { return root.getAttribute('data-theme') === 'dark'; }

  function syncTheme() {
    if (btn) btn.textContent = isDark() ? 'Light' : 'Dark';
    if (mobileState) mobileState.textContent = isDark() ? 'Light' : 'Dark';
  }

  function applyTheme(next: string) {
    root.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
    syncTheme();
  }

  btn?.addEventListener('click', () => applyTheme(isDark() ? 'light' : 'dark'));
  mobileBtn?.addEventListener('click', () => applyTheme(isDark() ? 'light' : 'dark'));
  syncTheme();

  // ── Mobile menu ──
  // While open, everything behind the overlay is inert, so Tab and screen
  // readers can only reach the (visible) header and the menu itself.
  const burger = document.getElementById('burger') as HTMLButtonElement;
  const menu = document.getElementById('mobile-menu') as HTMLElement;
  const behind = () => [document.querySelector('main'), document.querySelector('.site-footer')]
    .filter((el): el is HTMLElement => !!el);

  function isOpen() { return menu.classList.contains('is-open'); }

  function openMenu() {
    menu.classList.add('is-open');
    burger.classList.add('is-open');
    burger.setAttribute('aria-expanded', 'true');
    burger.setAttribute('aria-label', 'Close menu');
    menu.setAttribute('aria-hidden', 'false');
    menu.inert = false;
    behind().forEach(el => { el.inert = true; });
    // Lock scroll on <html> only. Locking <body> too turns it into its own scroll
    // container, and the sticky header then drops back by the scroll offset
    // (double rule, logo and close button pushed off screen).
    document.documentElement.style.overflow = 'hidden';
    menu.querySelector<HTMLElement>('.mobile-link')?.focus();
  }

  function closeMenu(returnFocus = true) {
    if (!isOpen()) return;
    menu.classList.remove('is-open');
    burger.classList.remove('is-open');
    burger.setAttribute('aria-expanded', 'false');
    burger.setAttribute('aria-label', 'Open menu');
    menu.setAttribute('aria-hidden', 'true');
    menu.inert = true;
    behind().forEach(el => { el.inert = false; });
    document.documentElement.style.overflow = '';
    if (returnFocus) burger.focus();
  }

  burger?.addEventListener('click', () => (isOpen() ? closeMenu() : openMenu()));
  // Following a link navigates away; don't pull focus back to the burger first.
  menu?.querySelectorAll('a[href^="/"]').forEach(link => link.addEventListener('click', () => closeMenu(false)));
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && isOpen()) closeMenu(); });
  // Rotating or resizing to desktop width hides the menu: release everything.
  matchMedia('(min-width: 641px)').addEventListener('change', e => { if (e.matches) closeMenu(false); });
</script>

<style>
  /* ── Desktop nav ── */
  .nav-logo-link { display: flex; align-items: center; min-width: 44px; min-height: 44px; text-decoration: none; }
  .nav-logo { height: 38px; width: 38px; display: block; }
  /* On night paper the near-black tile vanishes; a hairline keeps its edge. */
  :global([data-theme="dark"]) .nav-logo { outline: 1px solid var(--color-line); }
  .logo-node { fill: var(--color-accent); }

  .nav-links { display: flex; align-items: center; gap: 2rem; }

  .nav-link {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-text-muted);
    transition: color 0.12s ease;
  }
  .nav-link:hover, .nav-link.active { color: var(--color-accent); }

  .theme-toggle { background: none; border: none; padding: 0.625rem 0; cursor: pointer; }   /* ~38px tall target */

  .nav-sep {
    border-left: 1px solid var(--color-line);
    padding-left: 1.5rem;
    margin-left: 0.5rem;
  }

  /* ── Burger ── */
  .burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    width: 44px;
    height: 44px;
    align-items: flex-end;     /* keep the bars flush with the right gutter */
    margin-right: -2px;
  }

  .bar {
    display: block;
    width: 20px;
    height: 1px;
    background: var(--color-text);
    transition: transform 0.2s ease, opacity 0.2s ease;
    transform-origin: center;
  }

  .burger.is-open .bar-1 { transform: translateY(6px) rotate(45deg); }
  .burger.is-open .bar-2 { opacity: 0; transform: scaleX(0); }
  .burger.is-open .bar-3 { transform: translateY(-6px) rotate(-45deg); }

  /* ── Mobile menu overlay ── */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: var(--color-bg);
    padding-top: 3.5rem; /* h-14: the header stays visible above the menu */
    display: flex;
    flex-direction: column;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-6px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0.2s;
    overflow-y: auto;
  }

  .mobile-menu.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: all;
    transform: translateY(0);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s;
  }

  @media (min-width: 641px) {
    .mobile-menu { display: none; }
  }

  /* Destinations: hairline-ruled rows, page-label type (Page Label Compact). */
  .mobile-nav { border-top: 2px solid var(--color-rule); }

  .mobile-link {
    display: block;
    padding: 1.75rem 1.5rem;
    border-bottom: 1px solid var(--color-line);
    text-decoration: none;
    transition: background 0.1s ease;
  }
  /* Hover answers with a tint only; red is reserved for "you are here". */
  /* The list ends as a column of type, not an open box above the empty band. */
  .mobile-link:last-child { border-bottom: 0; }
  .mobile-link:hover, .mobile-link:active { background: var(--color-surface); }

  .mobile-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 0.95;
    text-transform: uppercase;
    color: var(--color-text);
  }
  .mobile-link.active .mobile-label { color: var(--color-accent); }

  /* Colophon: two compact rows, mirroring the page footer. */
  .mobile-colophon {
    margin-top: auto;
    padding: 0 1.5rem;
    border-top: 2px solid var(--color-rule);
  }
  .mobile-colophon-main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.125rem;
    padding: 1rem 0 0.625rem;
    border-bottom: 1px solid var(--color-line);
  }
  .mobile-mark { display: inline-flex; color: var(--color-text); padding-block: 0.25rem; }

  .mobile-colophon-base {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0 1rem;
    flex-wrap: wrap;
    padding: 0.25rem 0;
  }
  .mobile-profiles { display: flex; gap: 0 1.5rem; }

  /* Theme switch: a preference, set as a label pair on the base line. */
  .mobile-theme-row {
    display: inline-flex;
    align-items: baseline;
    gap: 0.625rem;
    padding: 0.5rem 0;          /* ~32px target, above the 24px WCAG floor */
    background: none;
    border: none;
    cursor: pointer;
  }

  .mobile-theme-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .mobile-theme-state {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text);
  }
  .mobile-theme-row:hover .mobile-theme-state { color: var(--color-accent); }

  /* ── Breakpoints ── */
  @media (max-width: 640px) {
    .nav-logo { height: 28px; width: 28px; }
    .nav-links { display: none; }
    .burger { display: flex; }
  }
</style>
