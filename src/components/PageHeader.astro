---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="page-header">
  <div class="max-w-5xl mx-auto px-6">
    <div class="ph-grid">
      <div class="ph-left">
        <h1 class="ph-label">{title}</h1>
      </div>
      <div class="ph-rule"></div>
      <div class="ph-right">
        <slot />
      </div>
    </div>
  </div>
</div>

<style>
  .page-header {
    border-bottom: 2px solid var(--color-rule);
    padding: 2rem 0;
  }

  .ph-grid {
    display: grid;
    grid-template-columns: 55% 2px 1fr;
    min-height: 7rem;
    align-items: start;
  }

  .ph-left {
    padding-right: 3rem;
    display: flex;
    align-items: flex-start;
  }

  .ph-label {
    font-family: var(--font-mono);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 0.95;
    color: var(--color-text);
    text-transform: uppercase;
    margin: 0;
  }

  .ph-rule {
    background: var(--color-rule);
    width: 2px;
    height: 100%;
    min-height: 7rem;
  }

  .ph-right {
    padding-left: 3rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    height: 100%;
    min-height: 7rem;
  }

  @media (max-width: 640px) {
    .page-header { padding: 2rem 0; }

    .ph-grid {
      grid-template-columns: 1fr;
      min-height: unset;
      gap: 1rem 0;
    }

    .ph-rule { display: none; }

    .ph-left { padding-right: 0; }

    .ph-label { font-size: 1.5rem; letter-spacing: -0.02em; }

    .ph-right {
      padding-left: 0;
      min-height: unset;
      border-top: 1px solid var(--color-line);
      padding-top: 1rem;
      gap: 0.75rem;
    }
  }
</style>
