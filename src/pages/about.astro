---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import { getCollection } from 'astro:content';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { postSlug, keepHyphens } from '@/data/site';

const stack = [
  { label: 'Backend', items: 'Go, Laravel, Node.js, Python, FastAPI, PHP' },
  { label: 'Frontend', items: 'Vue 3, Nuxt, React, TypeScript, JavaScript (ES6+)' },
  { label: 'Styling', items: 'Tailwind, SCSS/SASS, HTML5' },
  { label: 'Testing', items: 'Cypress, Mocha, TDD, Selenium' },
  { label: 'AI / RAG', items: 'RAG pipelines, LLM integration, vector indexing, permission-aware retrieval, Claude API' },
  { label: 'Infra', items: 'Docker, Kubernetes, GitLab CI/CD, OpenTelemetry, Vite, Webpack' },
  { label: 'Other', items: 'Supabase, Firebase, Keycloak, WordPress, Lokalise, Optimizely' },
];

const record = [
  'Led internationalisation across multiple teams and markets.',
  'Built shared component libraries to cut technical debt.',
  'Mentored engineers and ran technical interviews.',
];

const principles = [
  ['Decide before you build.', 'Write down the trade-off, then pick.'],
  ['Security is a design input,', 'not a review step.'],
  ['Prefer boring, explicit code.', 'Readability is a team asset.'],
];

const latestPost = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];

// CV section renders only once the PDF exists in public/, so the link can't 404.
const cvPath = '/alex-botzis-cv.pdf';
const hasCv = existsSync(join(process.cwd(), 'public', cvPath));
---

<Base title="About" description="Senior FullStack Engineer based in Greece. Information-security background, applied to AI systems. Working toward an Engineering Manager role.">

  <div class="animate-fade-up">
    <PageHeader title="About">
      <p class="headline">Security background,<br/>product engineering,<br/>AI systems.</p>
      <span class="exp-count">
        <span class="count-label">Since</span>
        <span class="count-num">2017</span>
      </span>
    </PageHeader>
  </div>

  <div class="max-w-5xl mx-auto px-6 animate-fade-up delay-2" style="padding-bottom: 4rem;">

    <section class="content-row" aria-labelledby="row-now">
      <h2 class="row-label" id="row-now">Now</h2>
      <div class="row-body">
        <p class="lead">Senior FullStack Engineer building B2B and B2C e-commerce at scale, fully remote, shipping microfrontends and the APIs and services they depend on.</p>
        <p>Lately: AI systems, where my information-security background (MS, University of East London) is most useful: finding the failure modes that pass every test.</p>
      </div>
    </section>

    <section class="content-row" aria-labelledby="row-record">
      <h2 class="row-label" id="row-record">Track record</h2>
      <div class="row-body">
        <ul class="ruled-list">
          {record.map(item => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="content-row" aria-labelledby="row-how">
      <h2 class="row-label" id="row-how">How I work</h2>
      <div class="row-body">
        <ul class="ruled-list">
          {principles.map(([head, rest]) => <li><strong>{head}</strong> {rest}</li>)}
        </ul>
      </div>
    </section>

    <section class="content-row" aria-labelledby="row-stack">
      <h2 class="row-label" id="row-stack">Stack</h2>
      <div class="row-body">
        <dl class="stack-grid">
          {stack.map(s => (
            <div class="stack-item">
              <dt class="stack-label">{s.label}</dt>
              <dd class="stack-items">{s.items}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="content-row" aria-labelledby="row-writing">
      <h2 class="row-label" id="row-writing">Writing</h2>
      <div class="row-body">
        <p>Long-form notes on the decisions behind the systems I build.</p>
        {latestPost && (
          <a href={`/blog/${postSlug(latestPost.id)}`} class="contact-link">Latest: {keepHyphens(latestPost.data.title)} →</a>
        )}
      </div>
    </section>

    {hasCv && (
      <section class="content-row" aria-labelledby="row-cv">
        <h2 class="row-label" id="row-cv">CV</h2>
        <div class="row-body">
          <p>The full work history, roles, and education live in the CV.</p>
          <a href={cvPath} download class="contact-link cv-link">Download CV (PDF) ↓</a>
        </div>
      </section>
    )}


  </div>

</Base>

<style>
  .headline {
    font-size: clamp(1.4rem, 2.8vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--color-text);
    margin: 0;
    text-wrap: balance; /* safety net if a line still has to wrap at mid widths */
  }

  .exp-count { display: flex; align-items: baseline; gap: 0.5rem; }
  .count-num {
    font-family: var(--font-mono);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 400;
    color: var(--color-accent);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .count-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .content-row {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: 0 3rem;
    padding: 2.5rem 0;
    border-top: 1px solid var(--color-line);
    align-items: start;
  }
  /* The masthead's 2px rule already closes the top; skip the doubled hairline. */
  .content-row:first-child { border-top: none; }
  /* The footer's 2px press rule closes the page; no trailing hairline above it. */

  /* Section titles: the mono label voice, promoted to a heading (ink, larger,
     heavier). The Stack sub-labels stay small and faint, one level below. */
  .row-label {
    font-family: var(--font-mono);
    font-size: clamp(0.9375rem, 0.875rem + 0.3vw, 1.0625rem);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.3;
    color: var(--color-text);
    padding-top: 0.15em;
    margin: 0;
  }

  .row-body p {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: 1.75;
    margin: 0 0 1rem;
    max-width: 60ch;
  }
  .row-body p:last-child { margin-bottom: 0; }

  /* Lead line in ink: the one sentence a skimmer must not miss. */
  .row-body .lead { color: var(--color-text); }

  /* Hairline-ruled list (broadsheet spec rows, no bullets). */
  .ruled-list { list-style: none; margin: 0; padding: 0; max-width: 60ch; }
  .ruled-list li {
    padding: 0.75rem 0;
    border-top: 1px solid var(--color-line);
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }
  .ruled-list li:first-child { border-top: none; padding-top: 0; }
  .ruled-list strong { font-weight: 600; color: var(--color-text); }

  /* ── Stack ── */
  /* Spec-sheet rows: faint mono label | list in ink, hairlines between rows. */
  .stack-grid { display: grid; grid-template-columns: 1fr; margin: 0; }
  .stack-item {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 0.25rem 1.5rem;
    align-items: baseline;
    padding: 0.75rem 0;
    border-top: 1px solid var(--color-line);
  }
  .stack-item:first-child { border-top: none; padding-top: 0.25rem; }
  .stack-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }
  .stack-items { font-size: var(--text-sm); color: var(--color-text); line-height: 1.55; margin: 0; }

  .cv-link { display: inline-block; margin-top: 1rem; }

  .contact-link {
    display: inline-block;
    padding-block: 0.25rem;
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-text);
    letter-spacing: -0.01em;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    text-decoration-color: var(--color-text-faint);
    transition: color 0.12s ease, text-decoration-color 0.12s ease;
  }
  .contact-link:hover { color: var(--color-accent); text-decoration-color: var(--color-accent); }

  @media (max-width: 640px) {
    .headline { font-size: 1.4rem; }
    /* Mobile rhythm: a scaled-down desktop, not a halved one. */
    .content-row { grid-template-columns: 1fr; gap: 0.75rem; padding: 2rem 0; }
    .row-body p { margin-bottom: 1.25rem; }
    /* Phones: label above its list, still hairline-separated rows. */
    .stack-item { grid-template-columns: 1fr; gap: 0.2rem; }
  }
</style>
