---
import Base from '@/layouts/Base.astro';
import Signature from '@/components/Signature.astro';
import { getCollection } from 'astro:content';
import { postSlug, formatDate, keepHyphens } from '@/data/site';
import { getProjects, projectHref, projectSlug, projectTitle } from '@/data/projects';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const posts = allPosts.slice(0, 4);
const postTitle = (slug?: string) => allPosts.find(p => postSlug(p.id) === slug)?.data.title;

const [feature, ...morePosts] = posts;
const projects = await getProjects();
---

<Base title="Alex Botzis">
<div class="page">

  <!-- ── Cover: the first screen signs itself ──
       Fills exactly the visible screen under the header (svh: stable when the
       mobile URL bar collapses). Headline and deck on top; at the bottom the
       signature is etched onto a 2px signature line, with the printed name below. -->
  <header class="cover">
    <div class="max-w-5xl mx-auto px-6 cover-inner">
      <div class="cover-head animate-fade-up">
        <h1 class="cover-headline">Engineering decisions that aren't obvious.</h1>
        <p class="cover-deck">Notes on AI systems, security, and the reasoning behind them.</p>
      </div>
      <div class="cover-sign">
        <Signature width="clamp(10rem, 105vw - 12.75rem, 22rem)">
          <a href="/about" class="mono-link">More about me →</a>
        </Signature>
        <span class="cover-line" aria-hidden="true"></span>
        <p class="cover-caption"><span>Senior FullStack Engineer</span></p>
      </div>
    </div>
  </header>

  <div class="max-w-5xl mx-auto px-6">

    <!-- ── Feature post: the page's one action ── -->
    {feature && (
      <section class="writing animate-fade-up delay-1" aria-labelledby="latest-writing">
      <div class="section-header reveal">
        <h2 class="section-label" id="latest-writing">Latest writing</h2>
        <a href="/blog" class="mono-link">All writing →</a>
      </div>
      <article class="feature reveal">
        <p class="feature-dateline">
          <time datetime={feature.data.pubDate.toISOString()}>{formatDate(feature.data.pubDate)}</time>
          {feature.data.tags[0] && <span>{feature.data.tags[0]}</span>}
        </p>
        <h3 class="feature-title" style={`view-transition-name: post-${postSlug(feature.id)}`}>
          <a href={`/blog/${postSlug(feature.id)}`} class="feature-link">{keepHyphens(feature.data.title)}</a>
        </h3>
        <p class="feature-desc">{feature.data.description}</p>
        <div class="feature-foot">
          <!-- Same target as the title, so it stays out of the tab order and the a11y tree. -->
          <a href={`/blog/${postSlug(feature.id)}`} class="mono-link" tabindex="-1" aria-hidden="true">Read →</a>
        </div>
      </article>
      </section>
    )}

    <!-- ── More posts ── -->
    {morePosts.length > 0 && (
      <section class="more-posts animate-fade-up delay-2" aria-labelledby="more-writing">
        <div class="section-header reveal">
          <h2 class="section-label" id="more-writing">More writing</h2>
        </div>
        <div class="more-grid" style={`--cols: ${morePosts.length}`}>
          {morePosts.map(post => (
            <a href={`/blog/${postSlug(post.id)}`} class="more-card reveal">
              <h3 class="more-title">{keepHyphens(post.data.title)}</h3>
              <p class="more-desc">{post.data.description}</p>
              <time class="more-date" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- ── Projects: credibility ── -->
    <section class="works animate-fade-up delay-3" aria-labelledby="selected-work">
      <div class="section-header reveal">
        <h2 class="section-label" id="selected-work">Selected work</h2>
        <a href="/projects" class="mono-link">All projects →</a>
      </div>
      <div class="works-list">
        {projects.map(p => (
          <article class="work reveal">
            <div class="work-body">
              <h3 class="work-name" style={`view-transition-name: project-${projectSlug(p.id)}`}><a href={projectHref(p.id)}>{projectTitle(p.data)}</a></h3>
              <p class="work-desc">{p.data.summary}</p>
              <dl class="work-spec">
                <div class="spec-row">
                  <dt>Stack</dt>
                  <dd>{p.data.stack.join(' · ')}</dd>
                </div>
                {p.data.post && postTitle(p.data.post) && (
                  <div class="spec-row">
                    <dt>Write-up</dt>
                    <dd><a href={`/blog/${p.data.post}`} class="feature-read">{keepHyphens(postTitle(p.data.post)!)} →</a></dd>
                  </div>
                )}
              </dl>
            </div>
          </article>
        ))}
      </div>
    </section>

  </div>
</div>
</Base>

<style>
  .page { padding-bottom: 6rem; }

  /* ── Cover ── */
  .cover-inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
    /* Exactly one screen under the 3.5rem header and its 2px rule. */
    min-height: calc(100vh - 3.625rem);
    min-height: calc(100svh - 3.625rem);
    max-height: 56rem;
    padding-top: clamp(2.5rem, 9vh, 6rem);
    padding-bottom: 1.75rem;
  }

  .cover-headline {
    font-size: clamp(2.75rem, 11.5vw, 5.25rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.98;
    color: var(--color-text);
    margin: 0;
    max-width: 14ch;
    text-wrap: balance;
  }

  .cover-deck {
    font-size: clamp(1.0625rem, 0.95rem + 0.6vw, 1.375rem);
    line-height: 1.45;
    color: var(--color-text-muted);
    margin: clamp(1.25rem, 3vh, 2rem) 0 0;
    max-width: 34ch;
    text-wrap: balance;
  }

  /* The signature line: a 2px press rule the name is signed onto. */
  .cover-sign { display: flex; flex-direction: column; align-items: flex-start; }
  /* Clear air between the signature's lowest stroke and the signature line. */
  /* Clear air between the etched signature (and its tail link) and the signature line. */
  .cover .cover-sign :global(.signature) { margin: 0 0 1.25rem; }
  .cover-line {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--color-rule);
  }
  /* Parts wrap as whole units (no separators), so a wrapped line never starts with "·". */
  .cover-caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;   /* printed name sits right, under the end of the line */
    align-self: stretch;
    gap: 0.25rem 1.5rem;
    margin: 0.75rem 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }
  .cover-caption span { white-space: nowrap; }

  /* ── Feature post ── */
  .writing { margin-top: 4rem; }

  .feature { padding: 2rem 0 0; }

  .feature-title {
    font-size: clamp(1.375rem, 1.15rem + 1vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.08;
    color: var(--color-text);
    margin: 0 0 1rem;
    text-wrap: balance;   /* one line where it fits; even lines on phones */
  }

  /* Item titles (post and project) share one link grammar: ink, faint underline,
     red wipe + red underline on hover/focus. */
  .feature-link {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--color-text-faint);
  }

  .feature-desc {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0 0 1.5rem;
    max-width: 58ch;
  }

  .feature-foot { display: flex; }

  /* Journal dateline: the date leads, so the block reads as a dated entry. */
  .feature-dateline {
    display: flex;
    gap: 1rem;
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }


  /* ── Section headers ── */
  /* Chapter break: clearly larger than any gap inside a section. */
  .more-posts, .works { margin-top: clamp(6.5rem, 5rem + 4vw, 8.5rem); }

  /* Section bar: a real heading in ink over a 2px press rule (broadsheet section head). */
  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--color-rule);
  }

  .section-label {
    font-size: clamp(1.75rem, 1.35rem + 1.6vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--color-text);
    margin: 0;
  }

  /* ── More posts ── */
  .more-grid {
    display: grid;
    grid-template-columns: repeat(var(--cols, 3), 1fr);
  }

  .more-card {
    display: block;
    padding: 1.5rem 1.25rem 1.5rem 0;
    border-right: 1px solid var(--color-line);
    text-decoration: none;
    transition: background 0.1s ease;
  }
  .more-card:last-child { border-right: none; padding-right: 0; }
  .more-card:not(:first-child) { padding-left: 1.25rem; }
  .more-card:hover { background: var(--color-surface); }

  .more-title {
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--color-text);
    margin: 0 0 0.4rem;
  }

  .more-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0 0 0.75rem;
  }

  .more-date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  /* ── Projects ── */

  .work {
    display: grid;
    padding: 1.5rem 0 0;
  }
  .work + .work { border-top: 1px solid var(--color-line); }

  .work-name {
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0 0 0.5rem;
  }
  .work-name a {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    text-decoration-color: var(--color-text-faint);
  }
  :is(.feature-link, .work-name a, .work-spec .feature-read):is(:hover, :focus-visible) { text-decoration-color: var(--color-accent); }

  .work-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0 0 1rem;
    max-width: 58ch;
  }

  /* Spec sheet (same grammar as the About stack): faint mono label | value in ink,
     hairlines between rows. Marks the block as a built thing, not an article. */
  .work-spec { margin: 0; max-width: 40rem; }
  .spec-row {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0.25rem 1.5rem;
    align-items: baseline;
    padding: 0.625rem 0;
    border-top: 1px solid var(--color-line);
  }
  .spec-row dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }
  .spec-row dd { margin: 0; font-size: var(--text-sm); color: var(--color-text); line-height: 1.55; }
  /* Inline (not inline-block) so the row's baseline is the link's first line. */
  .work-spec .feature-read {
    padding-block: 0.25rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    text-decoration-color: var(--color-text-faint);
  }
  .work-spec .feature-read:is(:hover, :focus-visible) { text-decoration-color: var(--color-accent); }

  /* ── Mobile ── */
  @media (max-width: 640px) {

    .writing { margin-top: 3rem; }
    .feature { padding-top: 1.5rem; }
    .feature-desc { font-size: var(--text-base); }
    /* Phones: label above value, as on the About stack. */
    .spec-row { grid-template-columns: 1fr; gap: 0.2rem; }


    .more-grid { grid-template-columns: 1fr; }
    .more-card { border-right: none; border-bottom: 1px solid var(--color-line); padding: 1.25rem 0; }
    .more-card:last-child { border-bottom: none; }
    .more-card:not(:first-child) { padding-left: 0; }

  }
</style>
