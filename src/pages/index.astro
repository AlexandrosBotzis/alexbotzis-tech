---
import Base from '@/layouts/Base.astro';
import Signature from '@/components/Signature.astro';
import { getCollection } from 'astro:content';
import { author, projects, postSlug, formatDate, keepHyphens } from '@/data/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const [feature, ...morePosts] = posts;
---

<Base title="Alex Botzis">
<div class="page">

  <!-- ── Hero ── -->
  <header class="hero animate-fade-up">
    <div class="max-w-5xl mx-auto px-6 hero-inner">
      <div class="hero-top">
        <h1 class="hero-headline">Engineering decisions<br/>that aren't obvious.</h1>
      </div>
      <div class="hero-bottom">
        <div class="hero-bio">
          <p class="hero-p">I'm Alex Botzis, based in Greece, shipping production software since 2017. My background is information security, and I apply it to AI systems: finding the failure modes that pass every test. Day to day, I build B2B and B2C e-commerce at scale.</p>
          <Signature>
            <a href="/about" class="mono-link">About →</a>
          </Signature>
        </div>
        <dl class="hero-meta">
          <div class="hero-fact">
            <dt class="fact-label">Role</dt>
            <dd class="fact-value">{author.role}</dd>
          </div>
          <div class="hero-fact">
            <dt class="fact-label">Location</dt>
            <dd class="fact-value">Remote (CET)</dd>
          </div>
          <div class="hero-fact">
            <dt class="fact-label">Focus</dt>
            <dd class="fact-value">AI · Security · Web</dd>
          </div>
        </dl>
      </div>
    </div>
  </header>

  <div class="max-w-5xl mx-auto px-6">

    <!-- ── Feature post: the page's one action ── -->
    {feature && (
      <article class="feature animate-fade-up delay-1">
        <h2 class="feature-title">
          <a href={`/blog/${postSlug(feature.id)}`} class="feature-link">{keepHyphens(feature.data.title)}</a>
        </h2>
        <p class="feature-desc">{feature.data.description}</p>
        <div class="feature-foot">
          <span class="feature-cta" aria-hidden="true">Read →</span>
          <span class="feature-meta">
            <time datetime={feature.data.pubDate.toISOString()}>{formatDate(feature.data.pubDate)}</time>
            {feature.data.tags[0] && <span>{feature.data.tags[0]}</span>}
          </span>
          <a href="/blog" class="mono-link feature-all">All writing →</a>
        </div>
      </article>
    )}

    <!-- ── More posts ── -->
    {morePosts.length > 0 && (
      <section class="more-posts animate-fade-up delay-2" aria-labelledby="more-writing">
        <div class="section-header">
          <h2 class="section-label" id="more-writing">More writing</h2>
        </div>
        <div class="more-grid" style={`--cols: ${morePosts.length}`}>
          {morePosts.map(post => (
            <a href={`/blog/${postSlug(post.id)}`} class="more-card">
              <h3 class="more-title">{keepHyphens(post.data.title)}</h3>
              <p class="more-desc">{post.data.description}</p>
              <time class="more-date" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- ── Projects: credibility ── -->
    <section class="works animate-fade-up delay-3" aria-labelledby="selected-work">
      <div class="section-header">
        <h2 class="section-label" id="selected-work">Selected work</h2>
      </div>
      <div class="works-list">
        {projects.map(p => (
          <article class="work">
            <div class="work-body">
              <h3 class="work-name"><a href={`/projects#${p.id}`}>{p.name}</a></h3>
              <p class="work-desc">{p.description}</p>
              {p.post && (
                <a href={`/blog/${p.post}`} class="mono-link">Read the write-up →</a>
              )}
            </div>
            <span class="work-stack">{p.stack}</span>
          </article>
        ))}
      </div>
    </section>

  </div>
</div>
</Base>

<style>
  .page { padding-bottom: 6rem; }

  /* ── Hero ── */
  .hero { border-bottom: 2px solid var(--color-rule); }

  .hero-inner { display: flex; flex-direction: column; }

  .hero-top {
    padding: 3.5rem 0 2.5rem;
    border-bottom: 1px solid var(--color-line);
  }

  .hero-headline {
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.02;
    color: var(--color-text);
    margin: 0;
  }

  .hero-bottom {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 0 3rem;
    padding: 1.75rem 0;
    align-items: start;
  }

  .hero-bio {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
  }

  .hero-p {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: 1.7;
    margin: 0;
    max-width: 62ch;
  }

  .hero-meta {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    border-left: 1px solid var(--color-line);
    padding-left: 3rem;
    margin: 0;
  }

  .hero-fact { display: flex; flex-direction: column; gap: 0.15rem; }

  .fact-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .fact-value {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.3;
    margin: 0;
  }

  /* ── Feature post ── */
  .feature {
    position: relative;
    margin-top: 3rem;
    padding: 2.5rem 0 2rem;
    border-bottom: 2px solid var(--color-rule);
    transition: background 0.1s ease;
  }
  .feature:hover { background: var(--color-surface); }
  .feature:has(.feature-link:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .feature-title {
    font-size: clamp(1.5rem, 1.1rem + 2vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.08;
    color: var(--color-text);
    margin: 0 0 1rem;
    max-width: 24ch;
    text-wrap: balance;
  }

  /* Whole block is the click target; the title carries the accessible name. */
  .feature-link { color: inherit; text-decoration: none; }
  .feature-link:focus-visible { outline: none; }
  .feature-link::after { content: ''; position: absolute; inset: 0; }

  .feature-desc {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0 0 1.5rem;
    max-width: 58ch;
  }

  .feature-foot {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .feature-cta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .feature-meta {
    display: inline-flex;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  /* Sits above the stretched link so it stays independently clickable. */
  .feature-all { position: relative; z-index: 1; margin-left: auto; padding-block: 0; }

  /* ── Section headers ── */
  .more-posts, .works { margin-top: 4rem; }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 0.25rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-faint);
    margin: 0;
    padding-block: 0.5rem;
  }

  /* ── More posts ── */
  .more-grid {
    display: grid;
    grid-template-columns: repeat(var(--cols, 3), 1fr);
    border-bottom: 1px solid var(--color-line);
  }

  .more-card {
    display: block;
    padding: 1.5rem 1.25rem 1.5rem 0;
    border-right: 1px solid var(--color-line);
    text-decoration: none;
    transition: background 0.1s ease;
  }
  .more-card:last-child { border-right: none; padding-right: 0; }
  .more-card:not(:first-child) { padding-left: 1.25rem; }
  .more-card:hover { background: var(--color-surface); }

  .more-title {
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--color-text);
    margin: 0 0 0.4rem;
  }

  .more-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0 0 0.75rem;
  }

  .more-date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  /* ── Projects ── */
  .works-list { border-bottom: 2px solid var(--color-rule); }

  .work {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.75rem 3rem;
    align-items: start;
    padding: 1.5rem 0 1.25rem;
  }
  .work + .work { border-top: 1px solid var(--color-line); }

  .work-name {
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0 0 0.5rem;
  }
  .work-name a {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    text-decoration-color: var(--color-text-faint);
    transition: color 0.12s ease, text-decoration-color 0.12s ease;
  }
  .work-name a:hover { color: var(--color-accent); text-decoration-color: var(--color-accent); }

  .work-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0 0 0.25rem;
    max-width: 58ch;
  }

  .work-stack {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    line-height: 1.8;
    color: var(--color-text-faint);
    max-width: 14rem;
    text-align: right;
    padding-top: 0.35rem;
  }

  /* ── Mobile ── */
  @media (max-width: 640px) {
    .hero-top { padding: 2.5rem 0 1.75rem; }
    .hero-headline { font-size: clamp(1.75rem, 7vw, 2.25rem); }
    .hero-bottom { grid-template-columns: 1fr; gap: 1.25rem 0; padding: 1.25rem 0; }
    /* Keep the facts on phones as a compact row under the bio. */
    .hero-meta {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.75rem 1.5rem;
      border-left: none;
      border-top: 1px solid var(--color-line);
      padding: 1rem 0 0;
    }

    .feature { margin-top: 3rem; padding: 2rem 0; }
    .feature-desc { font-size: var(--text-base); }
    .feature-all { margin-left: 0; }

    .more-posts, .works { margin-top: 3rem; }
    .more-grid { grid-template-columns: 1fr; }
    .more-card { border-right: none; border-bottom: 1px solid var(--color-line); padding: 1.25rem 0; }
    .more-card:last-child { border-bottom: none; }
    .more-card:not(:first-child) { padding-left: 0; }

    .work { grid-template-columns: 1fr; gap: 0.25rem; }
    .work-stack { text-align: left; max-width: none; padding-top: 0; }
  }
</style>
