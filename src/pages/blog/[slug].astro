---
import BlogPost from '@/layouts/BlogPost.astro';
import { getCollection, render } from 'astro:content';
import { postSlug } from '@/data/site';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  return posts.map((post, i) => {
    // "Next" reads backwards in time: the next-older post, if any.
    const older = posts[i + 1];
    return {
      params: { slug: postSlug(post.id) },
      props: {
        post,
        next: older ? { title: older.data.title, href: `/blog/${postSlug(older.id)}` } : undefined,
      },
    };
  });
}

const { post, next } = Astro.props;
const { Content } = await render(post);

const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(words / 230));
---

<BlogPost
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  tags={post.data.tags}
  slug={postSlug(post.id)}
  readingMinutes={readingMinutes}
  next={next}
>
  <Content />
</BlogPost>
